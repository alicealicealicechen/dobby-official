# Sanity — from the project's dashboard (Phase 0 of plan.md).
# Until NEXT_PUBLIC_SANITY_PROJECT_ID is set, the site serves its seed content
# and /studio shows setup instructions instead of the editor.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=staging

# Read token for draft previews (Sanity dashboard → API → Tokens).
SANITY_API_READ_TOKEN=

# Sanity — from the project's dashboard (Phase 0 of plan.md).
# Until NEXT_PUBLIC_SANITY_PROJECT_ID is set, the site serves its seed content
# and /studio shows setup instructions instead of the editor.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=staging

# One Sanity token, Editor role (dashboard → API → Tokens). Used for reading
# content — required while the dataset is private — and for storing contact
# form submissions.
SANITY_API_TOKEN=

# Contact form — the API route delivers to email AND Sanity, so one failing
# does not lose an enquiry.
RESEND_API_KEY=
CONTACT_TO_EMAIL=support@dobbyai.co
# Sender. Resend's sandbox address (onboarding@resend.dev) needs no DNS, but an
# unverified Resend account can ONLY send to the account owner's own address —
# any other recipient is rejected with 403. Verify dobbyai.co at
# resend.com/domains, then set this to something like no-reply@dobbyai.co.
CONTACT_FROM_EMAIL=no-reply@dobbyai.co
# Prefixes the subject while testing. Remove when the form goes live.
CONTACT_SUBJECT_PREFIX="[TEST] "
